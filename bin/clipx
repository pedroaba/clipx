#!/usr/bin/env bash
set -euo pipefail

# Resolve links so the installed launcher works from any working directory.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
REPO_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

if command -v uv >/dev/null 2>&1; then
    exec uv run --project "$REPO_DIR" python -m clipx.main "$@"
fi

if [ -x "$REPO_DIR/.venv/bin/python" ]; then
    cd "$REPO_DIR"
    exec "$REPO_DIR/.venv/bin/python" -m clipx.main "$@"
fi

echo "Ambiente ausente: instale uv e execute 'uv sync --frozen' no projeto." >&2
exit 1
