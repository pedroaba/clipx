#!/bin/sh
set -e
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
fi

if [ "${1:-}" = configure ] && [ -z "${DPKG_ROOT:-}" ]; then
    if [ ! -c /dev/uinput ] && command -v modprobe >/dev/null 2>&1; then
        modprobe uinput || echo "ClipX: não foi possível carregar o módulo uinput." >&2
    fi
    if [ ! -c /dev/uinput ]; then
        echo "ClipX: /dev/uinput indisponível; a colagem manual continua disponível." >&2
    fi
    if command -v udevadm >/dev/null 2>&1 && udevadm control --reload; then
        timeout 5s udevadm trigger --action=change \
            --subsystem-match=misc --sysname-match=uinput --settle \
            || echo "ClipX: não foi possível reaplicar a regra de uinput agora." >&2
    else
        echo "ClipX: udev indisponível; a regra de uinput será aplicada quando o dispositivo for inicializado." >&2
    fi
fi
